<<setup, include=FALSE>>=
library(knitr)
opts_chunk$set(
  echo       = FALSE,   # o codigo NAO aparece: ele mora em estrutura/codigo/
  message    = FALSE,
  warning    = FALSE,
  fig.align  = "center",
  out.width  = "0.38\\linewidth",
  fig.width  = 4,
  fig.height = 2.0
)
options(OutDec = ",", digits = 4)
# Garante UTF-8 na sessao (evita <U+00E9> no lugar de acentos). No Windows
# o aviso e inofensivo.
suppressWarnings(try(Sys.setlocale("LC_ALL", "C.UTF-8"), silent = TRUE))
@

<<dados, include=FALSE>>=
# =========================================================================
#  O corpus do grupo: 63 paragrafos dos verbetes de Santos, Cubatao e
#  Guaruja, lidos de estrutura/corpus/paragrafos.csv.
# =========================================================================
caminhos <- c("../estrutura/corpus/paragrafos.csv",
              "estrutura/corpus/paragrafos.csv")
arquivo  <- caminhos[file.exists(caminhos)][1]
if (is.na(arquivo)) stop("paragrafos.csv nao encontrado. Compile a partir de entregas/.")
tab <- read.csv(arquivo, fileEncoding = "UTF-8", stringsAsFactors = FALSE)

docs   <- setNames(tab$texto, tab$doc_id)
origem <- tab$cidade
corpus_de_teste <- FALSE

# REGRA: nada de acento dentro de string de R -- o acento quebra quando a
# sessao do R nao esta em locale UTF-8. Onde precisar, escreva o acento em
# LaTeX ("m\\'edia"): o \Sexpr repassa intacto.
nome_pag <- c(Santos = "Santos", Cubatao = "Cubat\\~ao", Guaruja = "Guaruj\\'a")

# formatos brasileiros: virgula decimal e ponto de milhar
vir <- function(x, d = 1) format(round(x, d), nsmall = d, decimal.mark = ",")
mil <- function(x) format(x, big.mark = ".", decimal.mark = ",", scientific = FALSE)

# --- a cadeia da Aula 01, sobre o corpus ---------------------------------
tokenizar <- function(texto) unlist(strsplit(tolower(texto), "\\s+"))
tokens <- lapply(docs, tokenizar)
tam    <- sapply(tokens, length)                 # tokens por documento
vocab  <- sort(unique(unlist(tokens)))
freq   <- sort(table(unlist(tokens)), decreasing = TRUE)

n_docs   <- length(docs)
n_pags   <- length(unique(origem))
n_vocab  <- length(vocab)
n_tokens <- sum(tam)
min_char <- min(nchar(docs))
quartis  <- quantile(tam, c(0.25, 0.75))

# --- os textos prontos para o \Sexpr -------------------------------------
texto_tam   <- paste0(min(tam), " a ", max(tam), " (m\\'edia ", vir(mean(tam)), ")")
top10       <- names(freq)[1:10]
texto_top10 <- paste0("\\texttt{", gsub("([%&_#$])", "\\\\\\1", top10), "}", collapse = ", ")

# documentos por pagina, e quem domina
por_pag   <- sort(table(origem), decreasing = TRUE)
pct_dom   <- as.integer(round(100 * por_pag[1] / n_docs))
texto_dom <- paste0(nome_pag[[names(por_pag)[1]]], ": ", por_pag[1], " de ", n_docs,
                    " (", pct_dom, "\\%)")

# documentos curtos e longos demais (suspeitos de nao serem prosa)
curtos <- sum(tam < 20)
longos <- sum(tam > 300)
texto_extremos <- paste0(curtos, " com menos de 20 tokens; ", longos, " com mais de 300")

# sinais de sujeira: acentos, pontuacao grudada, digitos
tem_acento <- sum(grepl("[^ -~]", docs))
tem_pont   <- sum(grepl("[[:punct:]]", docs))
tem_dig    <- sum(grepl("[0-9]", docs))
texto_sujo <- paste0(tem_acento, " com acento, ", tem_pont, " com pontua\\c{c}\\~ao, ",
                     tem_dig, " com d\\'igitos (de ", n_docs, ")")

# paragrafos que sao quase so numeros (listas de indicadores)
n_dig_doc <- sapply(gregexpr("[0-9]", docs), function(m) sum(m > 0))
numericos <- names(docs)[n_dig_doc >= 40]

# tabela de origem
tab_origem <- data.frame(
  Pagina     = nome_pag[names(por_pag)],
  Documentos = as.integer(por_pag),
  Tokens     = vir(tapply(tam, origem, mean)[names(por_pag)]),
  row.names  = NULL
)
names(tab_origem) <- c("P\\'agina", "Documentos", "Tokens (m\\'edia)")
@

\selectlanguage{brazil}
\frenchspacing

